{
  "name": "exotic-dangerous-server",
  "version": "1.0.0",
  "description": "Server for hosting Exotic Dangerous worlds",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node src/utils/initDb.js",
    "update-tags": "node src/utils/runUpdateWorldTags.js",
    "backup": "node src/utils/runBackup.js",
    "restore": "node src/utils/runRestore.js",
    "list-backups": "node src/utils/listBackups.js",
    "cleanup-backups": "node src/utils/cleanupBackups.js",
    "snapshot": "node src/utils/runSnapshot.js",
    "list-snapshots": "node src/utils/listSnapshots.js",
    "cleanup-snapshots": "node src/utils/cleanupSnapshots.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
